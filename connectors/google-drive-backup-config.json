{
  "version": "1.0",
  "metadata": {
    "name": "warnetech-server-google-drive-backup",
    "description": "Automated backup system using separate Google account",
    "backupAccount": "warnet.dev01@gmail.com",
    "createdAt": "2026-08-02T12:30:00Z",
    "purpose": "Isolated backup storage for database, logs, and audit trails"
  },
  "authentication": {
    "type": "google_service_account",
    "method": "oauth2_service_account",
    "credentialLocation": "KV:warnetech-server-vault",
    "keyName": "google-backup-service-key",
    "scopes": [
      "https://www.googleapis.com/auth/drive",
      "https://www.googleapis.com/auth/drive.file"
    ],
    "serviceAccountEmail": "TO-BE-GENERATED-IN-GCP",
    "notes": "Service account email will be generated when creating service account in Google Cloud Console"
  },
  "storage": {
    "account": "warnet.dev01@gmail.com",
    "rootFolderName": "warnetech-server-backups",
    "folderStructure": {
      "daily": {
        "path": "/warnetech-server-backups/daily",
        "retention_days": 30,
        "description": "Daily automated database backups"
      },
      "weekly": {
        "path": "/warnetech-server-backups/weekly",
        "retention_days": 90,
        "description": "Weekly full exports"
      },
      "monthly": {
        "path": "/warnetech-server-backups/monthly",
        "retention_days": 365,
        "description": "Monthly archives"
      },
      "logs": {
        "path": "/warnetech-server-backups/logs",
        "retention_days": 90,
        "description": "Connector audit logs and error logs"
      },
      "audit_trail": {
        "path": "/warnetech-server-backups/audit",
        "retention_days": 365,
        "description": "Complete audit trail of all operations"
      },
      "documents": {
        "path": "/warnetech-server-backups/documents",
        "retention_days": null,
        "description": "Configuration and reference documents"
      },
      "metadata": {
        "path": "/warnetech-server-backups/metadata",
        "retention_days": 365,
        "description": "Backup manifests and recovery instructions"
      }
    }
  },
  "backup_policies": {
    "database": {
      "enabled": true,
      "source": "D1:warnetech-server-data",
      "frequency": "daily",
      "schedule": "02:00 UTC",
      "format": "json",
      "compression": "gzip",
      "tables": [
        "users",
        "messages",
        "memories",
        "shared_knowledge",
        "connector_audit_log",
        "agent_actions",
        "agent_learnings"
      ],
      "destination": "daily",
      "filename_pattern": "warnetech-server-data-{TIMESTAMP}.json.gz",
      "retention": 30
    },
    "audit_logs": {
      "enabled": true,
      "source": "D1:connector_audit_log",
      "frequency": "hourly",
      "format": "json",
      "destination": "logs",
      "filename_pattern": "audit-{TIMESTAMP}.json",
      "retention": 90
    },
    "full_export": {
      "enabled": true,
      "source": "D1:*",
      "frequency": "weekly",
      "schedule": "Sunday 03:00 UTC",
      "format": "sql",
      "destination": "weekly",
      "filename_pattern": "warnetech-server-full-export-{TIMESTAMP}.sql",
      "retention": 90
    },
    "monthly_archive": {
      "enabled": true,
      "frequency": "monthly",
      "schedule": "1st of month 04:00 UTC",
      "source": "weekly",
      "format": "zip",
      "destination": "monthly",
      "filename_pattern": "warnetech-server-archive-{YEAR}-{MONTH}.zip",
      "retention": 365
    },
    "connector_logs": {
      "enabled": true,
      "frequency": "daily",
      "source": "Logpush:gateway_http",
      "destination": "logs",
      "filename_pattern": "connector-logs-{TIMESTAMP}.json",
      "retention": 90
    }
  },
  "failure_handling": {
    "retry_policy": {
      "max_retries": 3,
      "backoff_seconds": [5, 15, 60]
    },
    "on_failure": "log_and_alert",
    "alert_email": "jasoensyd26@gmail.com",
    "alert_threshold": "2 consecutive failures"
  },
  "security": {
    "encryption_in_transit": "TLS 1.3",
    "encryption_at_rest": "Google Drive native encryption",
    "access_control": "service_account_only",
    "audit_logging": true,
    "service_account_permissions": [
      "drive.file",
      "drive"
    ],
    "notes": "Service account has access only to shared folders, not entire drive"
  },
  "recovery": {
    "restore_procedures": "See RESTORE.md",
    "verification": "Automated weekly restore test",
    "backup_validation": "Hash check on all uploads",
    "recovery_time_objective": "< 2 hours",
    "recovery_point_objective": "< 1 day"
  },
  "monitoring": {
    "health_checks": {
      "backup_success": {
        "frequency": "daily",
        "alert_on_failure": true
      },
      "folder_size": {
        "frequency": "weekly",
        "threshold_gb": 50,
        "alert_on_exceed": true
      },
      "oldest_backup": {
        "frequency": "daily",
        "alert_if_older_than_hours": 26
      }
    },
    "metrics": [
      "backup_duration_seconds",
      "backup_size_bytes",
      "backup_success_rate",
      "restore_test_success_rate",
      "upload_errors",
      "quota_usage_percent"
    ]
  }
}
