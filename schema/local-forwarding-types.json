{
  "version": "1.0.0",
  "title": "Local Forwarding API Data Types",
  "description": "Type definitions for local port forwarding configuration and session management",
  "timestamp": "2026-08-02",
  "types": {
    "LocalForwardingConfig": {
      "description": "Configuration for a local forwarding tunnel",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique configuration ID"
        },
        "config_name": {
          "type": "string",
          "description": "Unique name for this forwarding config",
          "example": "dev-db-tunnel"
        },
        "vault_id": {
          "type": "integer",
          "description": "Vault this rule belongs to (see Vault type)",
          "example": 1
        },
        "vault_name": {
          "type": "string",
          "description": "Denormalized vault name for display",
          "example": "Personal Vault"
        },
        "local_port": {
          "type": "integer",
          "description": "Port number on local (current) machine",
          "minimum": 1024,
          "maximum": 65535,
          "example": 3306
        },
        "bind_address": {
          "type": "string",
          "description": "Address to bind the local port to",
          "default": "127.0.0.1",
          "example": "127.0.0.1"
        },
        "remote_host": {
          "type": "string",
          "description": "Hostname or IP of remote server",
          "example": "database.internal.example.com"
        },
        "remote_port": {
          "type": "integer",
          "description": "Port on remote server to forward traffic to",
          "minimum": 1,
          "maximum": 65535,
          "example": 3306
        },
        "tunnel_type": {
          "type": "string",
          "enum": ["ssh", "https", "cloudflare-tunnel"],
          "default": "ssh",
          "description": "Type of tunnel protocol to use"
        },
        "status": {
          "type": "string",
          "enum": ["inactive", "active", "error"],
          "default": "inactive",
          "description": "Current status of the forwarding configuration"
        },
        "created_by": {
          "type": "string",
          "description": "Username of creator"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when config was created"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last update"
        }
      },
      "required": ["local_port", "remote_host", "remote_port"]
    },
    "CreateForwardingRequest": {
      "description": "Request payload to create a new local forwarding config",
      "type": "object",
      "properties": {
        "config_name": {
          "type": "string",
          "description": "Unique name for this configuration"
        },
        "vault_id": {
          "type": "integer",
          "description": "Vault to store this rule's secret material in. Defaults to the caller's Personal Vault if omitted."
        },
        "local_port": {
          "type": "integer",
          "description": "Port number to open locally"
        },
        "bind_address": {
          "type": "string",
          "description": "Optional bind address (defaults to 127.0.0.1)"
        },
        "remote_host": {
          "type": "string",
          "description": "Remote host to forward to"
        },
        "remote_port": {
          "type": "integer",
          "description": "Remote port to forward to"
        },
        "tunnel_type": {
          "type": "string",
          "enum": ["ssh", "https", "cloudflare-tunnel"],
          "description": "Tunnel protocol type"
        }
      },
      "required": ["config_name", "local_port", "remote_host", "remote_port"]
    },
    "ForwardingSession": {
      "description": "Active forwarding tunnel session",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Session ID"
        },
        "config_id": {
          "type": "integer",
          "description": "Reference to config"
        },
        "session_id": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "tunnel_host": {
          "type": "string",
          "description": "Host where tunnel is established"
        },
        "tunnel_port": {
          "type": "integer",
          "description": "Port where tunnel is listening"
        },
        "status": {
          "type": "string",
          "enum": ["establishing", "active", "closing", "closed", "error"],
          "description": "Current session status"
        },
        "established_at": {
          "type": "string",
          "format": "date-time",
          "description": "When tunnel was successfully established"
        },
        "closed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When tunnel was closed"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ForwardingMetrics": {
      "description": "Performance metrics for an active forwarding session",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "session_id": {
          "type": "integer"
        },
        "bytes_sent": {
          "type": "integer",
          "description": "Total bytes sent through tunnel"
        },
        "bytes_received": {
          "type": "integer",
          "description": "Total bytes received through tunnel"
        },
        "active_connections": {
          "type": "integer",
          "description": "Current active connections"
        },
        "latency_ms": {
          "type": "integer",
          "description": "Tunnel latency in milliseconds"
        },
        "last_activity_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last activity"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "description": "When metrics were recorded"
        }
      }
    },
    "ForwardingAuditLog": {
      "description": "Audit log entry for forwarding activities",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "config_id": {
          "type": "integer"
        },
        "session_id": {
          "type": "integer"
        },
        "event_type": {
          "type": "string",
          "enum": ["config_created", "config_updated", "config_deleted", "session_started", "session_closed", "session_error"],
          "description": "Type of event"
        },
        "details": {
          "type": "string",
          "description": "Additional details or error messages"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "user": {
          "type": "string",
          "description": "User who triggered the event"
        }
      }
    },
    "Vault": {
      "description": "A named grouping of forwarding rules whose secret material is stored in a Cloudflare backend, optionally backed up to Google Drive",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "description": "Display name shown in the vault picker",
          "example": "Personal Vault"
        },
        "owner": {
          "type": "string",
          "description": "Username/email of the vault owner"
        },
        "storage_backend": {
          "type": "string",
          "enum": ["cloudflare_kv", "cloudflare_secrets_store"],
          "default": "cloudflare_kv",
          "description": "Where the vault's encrypted secret values actually live"
        },
        "cloudflare_namespace_id": {
          "type": "string",
          "description": "KV namespace ID (or Secrets Store ID) backing this vault"
        },
        "cloudflare_account_id": {
          "type": "string",
          "description": "Cloudflare account the namespace belongs to"
        },
        "drive_backup_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether vault metadata is periodically exported to Google Drive"
        },
        "drive_backup_folder_id": {
          "type": "string",
          "description": "Google Drive folder ID that backups are written to"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "owner"]
    },
    "CreateVaultRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "storage_backend": {
          "type": "string",
          "enum": ["cloudflare_kv", "cloudflare_secrets_store"]
        },
        "cloudflare_account_id": {
          "type": "string"
        },
        "drive_backup_enabled": {
          "type": "boolean"
        },
        "drive_backup_folder_id": {
          "type": "string"
        }
      },
      "required": ["name"]
    },
    "VaultBackup": {
      "description": "Record of one export of a vault's forwarding-rule metadata to Google Drive",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "vault_id": {
          "type": "integer"
        },
        "drive_file_id": {
          "type": "string",
          "description": "Google Drive file ID of the exported JSON"
        },
        "drive_file_url": {
          "type": "string",
          "description": "webViewLink for the exported file"
        },
        "backup_type": {
          "type": "string",
          "enum": ["full", "incremental"],
          "default": "full"
        },
        "record_count": {
          "type": "integer",
          "description": "Number of forwarding rules included in this backup"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed"]
        },
        "error": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "endpoints": {
    "POST /api/vaults": {
      "description": "Create a vault. If cloudflare_account_id is set and storage_backend is cloudflare_kv, the server provisions a matching Cloudflare KV namespace and stores its ID.",
      "request": {
        "$ref": "#/types/CreateVaultRequest"
      },
      "response": {
        "$ref": "#/types/Vault"
      }
    },
    "GET /api/vaults": {
      "description": "List vaults visible to the caller",
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/types/Vault"
        }
      }
    },
    "POST /api/vaults/:id/backup": {
      "description": "Export this vault's forwarding-rule metadata (config rows, not decrypted secrets) as JSON and upload it to drive_backup_folder_id in Google Drive",
      "response": {
        "$ref": "#/types/VaultBackup"
      }
    },
    "GET /api/vaults/:id/backups": {
      "description": "List backup history for a vault",
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/types/VaultBackup"
        }
      }
    },
    "POST /api/forwarding": {
      "description": "Create a new local forwarding configuration",
      "request": {
        "$ref": "#/types/CreateForwardingRequest"
      },
      "response": {
        "$ref": "#/types/LocalForwardingConfig"
      }
    },
    "GET /api/forwarding": {
      "description": "List all forwarding configurations",
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/types/LocalForwardingConfig"
        }
      }
    },
    "GET /api/forwarding/:id": {
      "description": "Get specific forwarding configuration",
      "response": {
        "$ref": "#/types/LocalForwardingConfig"
      }
    },
    "PUT /api/forwarding/:id": {
      "description": "Update forwarding configuration",
      "request": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["active", "inactive"]
          },
          "bind_address": {
            "type": "string"
          }
        }
      },
      "response": {
        "$ref": "#/types/LocalForwardingConfig"
      }
    },
    "DELETE /api/forwarding/:id": {
      "description": "Delete forwarding configuration",
      "response": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "POST /api/forwarding/:id/start": {
      "description": "Start a forwarding session",
      "response": {
        "$ref": "#/types/ForwardingSession"
      }
    },
    "POST /api/forwarding/:id/stop": {
      "description": "Stop an active forwarding session",
      "response": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      }
    },
    "GET /api/forwarding/:id/metrics": {
      "description": "Get metrics for an active session",
      "response": {
        "$ref": "#/types/ForwardingMetrics"
      }
    },
    "GET /api/forwarding/:id/audit": {
      "description": "Get audit log for a configuration",
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/types/ForwardingAuditLog"
        }
      }
    }
  },
  "examples": {
    "create_request": {
      "config_name": "staging-database",
      "vault_id": 1,
      "local_port": 3306,
      "bind_address": "127.0.0.1",
      "remote_host": "db-staging.internal.aws.example.com",
      "remote_port": 3306,
      "tunnel_type": "ssh"
    },
    "created_config": {
      "id": 1,
      "config_name": "staging-database",
      "vault_id": 1,
      "vault_name": "Personal Vault",
      "local_port": 3306,
      "bind_address": "127.0.0.1",
      "remote_host": "db-staging.internal.aws.example.com",
